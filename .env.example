PORT=5500
APP_ORIGIN=http://127.0.0.1:5500
TMDB_API_READ_ACCESS_TOKEN=replace_with_your_tmdb_read_access_token

# Supabase project configuration
# Use the project URL and the publishable/anon key in browser-safe code only if needed for client-side components.
# Keep secret and service-role values on the server only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace_with_your_supabase_publishable_key
SUPABASE_PUBLISHABLE_KEY=replace_with_your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_supabase_service_role_key_only_on_server
